// Esquema inicial de destino para la vertical de acceso.
// No ejecutar migraciones hasta inspeccionar el esquema PostgreSQL disponible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String              @id @default(cuid())
  email                       String              @unique
  username                    String              @unique
  displayName                 String              @map("display_name")
  status                      String?
  statusUpdatedAt             DateTime?           @map("status_updated_at")
  profilePrivacy              Int                 @default(63) @map("profile_privacy")
  commentsPrivacy             Int                 @default(63) @map("comments_privacy")
  saveProfileViews            Boolean             @default(true) @map("save_profile_views")
  passwordHash                String              @map("password_hash")
  passwordMethod              Int                 @default(0) @map("password_method")
  verificationTokenHash       String?             @map("verification_token_hash")
  verificationSentAt          DateTime?           @map("verification_sent_at")
  verifiedAt                  DateTime?           @map("verified_at")
  passwordResetTokenHash      String?             @map("password_reset_token_hash")
  passwordResetSentAt         DateTime?           @map("password_reset_sent_at")
  enabled                     Boolean             @default(true)
  signUpDate                  DateTime            @default(now()) @map("sign_up_date")
  loginCount                  Int                 @default(0) @map("login_count")
  lastLoginAt                 DateTime?           @map("last_login_at")
  lastActiveAt                DateTime?           @map("last_active_at")
  levelId                     String?             @map("level_id")
  subnetworkId                String?             @map("subnetwork_id")
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")
  sessions                    AuthSession[]
  profileFieldValues          ProfileFieldValue[]
  friendRequestsSent          FriendConnection[]  @relation("FriendRequester")
  friendRequestsReceived      FriendConnection[]  @relation("FriendAddressee")
  blocksCreated               ProfileBlock[]      @relation("ProfileBlocker")
  blocksReceived              ProfileBlock[]      @relation("ProfileBlocked")
  activities                  Activity[]          @relation("ActivityActor")
  profileCommentsReceived     ProfileComment[]    @relation("ProfileCommentOwner")
  profileCommentsAuthored     ProfileComment[]    @relation("ProfileCommentAuthor")
  profileViewStats            ProfileViewStats?
  profileViewers              ProfileViewViewer[] @relation("ProfileViewViewer")
  notificationsReceived       Notification[]      @relation("NotificationRecipient")
  notificationsSent           Notification[]      @relation("NotificationActor")
  notificationsAsProfileOwner Notification[]      @relation("NotificationProfileOwner")
  businessesOwned             Business[]          @relation("BusinessOwner")
  classifiedsOwned            Classified[]        @relation("ClassifiedOwner")
  eventsOwned                 Event[]             @relation("EventOwner")
  groupsOwned                 Group[]             @relation("GroupOwner")
  groupMemberships            GroupMember[]       @relation("GroupMemberUser")
  eventMemberships            EventMember[]       @relation("EventMemberUser")
  blogEntriesAuthored         BlogEntry[]         @relation("BlogEntryAuthor")
  articlesAuthored            Article[]           @relation("ArticleAuthor")
  forumPostsAuthored          ForumPost[]         @relation("ForumPostAuthor")
  identityMappings            UserIdentityMap[]   @relation("IdentityMapUser")
  canonicalMappings           UserIdentityMap[]   @relation("IdentityMapCanonical")
  albumsOwned                 Album[]             @relation("AlbumOwner")
  pollsOwned                  Poll[]              @relation("PollOwner")
  pollVotes                   PollVote[]          @relation("PollVoter")
  level                       UserLevel?          @relation(fields: [levelId], references: [id], onDelete: SetNull)
  subnetwork                  Subnetwork?         @relation(fields: [subnetworkId], references: [id], onDelete: SetNull)

  @@index([enabled, verifiedAt])
  @@index([levelId])
  @@index([subnetworkId])
  @@map("users")
}

model AuthSession {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model FriendConnection {
  id          String   @id @default(cuid())
  requesterId String   @map("requester_id")
  addresseeId String   @map("addressee_id")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friend_connections")
}

model ProfileBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("ProfileBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ProfileBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("profile_blocks")
}

model ProfileCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  parentId  String? @map("parent_id")

  parent   ProfileCategory?  @relation("ProfileCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProfileCategory[] @relation("ProfileCategoryHierarchy")
  fields   ProfileField[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("profile_categories")
}

model ProfileField {
  id              String  @id @default(cuid())
  legacyId        Int?    @unique @map("legacy_id")
  categoryId      String  @map("category_id")
  parentFieldId   String? @map("parent_field_id")
  fieldKey        String  @unique @map("field_key")
  label           String
  description     String?
  type            String
  sortOrder       Int     @default(0) @map("sort_order")
  required        Boolean @default(false)
  maxLength       Int?    @map("max_length")
  options         Json?
  displayMode     Int     @default(1) @map("display_mode")
  validationRegex String? @map("validation_regex")
  allowHtml       Boolean @default(false) @map("allow_html")
  active          Boolean @default(true)

  category        ProfileCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parentField     ProfileField?       @relation("ProfileFieldDependency", fields: [parentFieldId], references: [id], onDelete: SetNull)
  dependentFields ProfileField[]      @relation("ProfileFieldDependency")
  values          ProfileFieldValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId, active, sortOrder])
  @@index([parentFieldId])
  @@map("profile_fields")
}

model ProfileFieldValue {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  fieldId   String   @map("field_id")
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  field ProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@map("profile_field_values")
}

model Activity {
  id            String   @id @default(cuid())
  actorId       String   @map("actor_id")
  type          String
  text          String
  objectPrivacy Int      @map("object_privacy")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, type, createdAt])
  @@index([createdAt])
  @@map("activities")
}

model ProfileComment {
  id             String   @id @default(cuid())
  profileOwnerId String   @map("profile_owner_id")
  authorId       String   @map("author_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profileOwner User @relation("ProfileCommentOwner", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  author       User @relation("ProfileCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([profileOwnerId, createdAt])
  @@index([authorId, createdAt])
  @@map("profile_comments")
}

model ProfileViewStats {
  id             String   @id @default(cuid())
  profileOwnerId String   @unique @map("profile_owner_id")
  totalViews     Int      @default(0) @map("total_views")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profileOwner User                @relation(fields: [profileOwnerId], references: [id], onDelete: Cascade)
  viewers      ProfileViewViewer[]

  @@map("profile_view_stats")
}

model ProfileViewViewer {
  id       String   @id @default(cuid())
  statsId  String   @map("stats_id")
  viewerId String   @map("viewer_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  stats  ProfileViewStats @relation(fields: [statsId], references: [id], onDelete: Cascade)
  viewer User             @relation("ProfileViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statsId, viewerId])
  @@index([statsId, viewedAt])
  @@index([viewerId, viewedAt])
  @@map("profile_view_viewers")
}

model Notification {
  id             String    @id @default(cuid())
  recipientId    String    @map("recipient_id")
  actorId        String    @map("actor_id")
  profileOwnerId String    @map("profile_owner_id")
  type           String
  legacyTypeId   Int?      @map("legacy_type_id")
  objectId       String    @map("object_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  recipient    User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  profileOwner User @relation("NotificationProfileOwner", fields: [profileOwnerId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, type, createdAt])
  @@map("notifications")
}

model BusinessCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  parentId  String? @map("parent_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  parent     BusinessCategory?  @relation("BusinessCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   BusinessCategory[] @relation("BusinessCategoryHierarchy")
  businesses Business[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("business_categories")
}

model Business {
  id             String    @id @default(cuid())
  legacyId       Int?      @unique @map("legacy_id")
  ownerId        String    @map("owner_id")
  categoryId     String?   @map("category_id")
  title          String
  slug           String?   @unique
  summary        String?
  description    String?
  city           String?
  province       String?
  country        String?
  postalCode     String?   @map("postal_code")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")
  approvedAt     DateTime? @map("approved_at")
  expiresAt      DateTime? @map("expires_at")
  searchable     Boolean   @default(true)
  privacy        Int       @default(63)
  catalogVisible Boolean   @default(false) @map("catalog_visible")
  featured       Boolean   @default(false)
  sponsored      Boolean   @default(false)
  rating         Float     @default(0)
  weightedRating Float     @default(0) @map("weighted_rating")
  views          Int       @default(0)
  totalComments  Int       @default(0) @map("total_comments")

  owner    User              @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category BusinessCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([categoryId, searchable, catalogVisible, approvedAt, expiresAt])
  @@index([searchable, catalogVisible, approvedAt, expiresAt, createdAt])
  @@map("businesses")
}

model ClassifiedCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  parentId  String? @map("parent_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  parent      ClassifiedCategory?  @relation("ClassifiedCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ClassifiedCategory[] @relation("ClassifiedCategoryHierarchy")
  classifieds Classified[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("classified_categories")
}

model Classified {
  id             String   @id @default(cuid())
  legacyId       Int?     @unique @map("legacy_id")
  ownerId        String   @map("owner_id")
  categoryId     String?  @map("category_id")
  title          String
  body           String?
  slug           String?  @unique
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")
  searchable     Boolean  @default(true)
  privacy        Int      @default(63)
  catalogVisible Boolean  @default(false) @map("catalog_visible")
  views          Int      @default(0)
  totalComments  Int      @default(0) @map("total_comments")

  owner    User                @relation("ClassifiedOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category ClassifiedCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([ownerId, categoryId])
  @@index([categoryId, searchable, catalogVisible, createdAt])
  @@index([searchable, catalogVisible, createdAt])
  @@map("classifieds")
}

model EventCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  parentId  String? @map("parent_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  parent   EventCategory?  @relation("EventCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children EventCategory[] @relation("EventCategoryHierarchy")
  events   Event[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("event_categories")
}

model Event {
  id             String    @id @default(cuid())
  legacyId       Int?      @unique @map("legacy_id")
  ownerId        String    @map("owner_id")
  categoryId     String?   @map("category_id")
  title          String
  description    String?
  host           String?
  location       String?
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")
  searchable     Boolean   @default(true)
  privacy        Int       @default(64)
  catalogVisible Boolean   @default(false) @map("catalog_visible")
  inviteOnly     Boolean   @default(false) @map("invite_only")
  views          Int       @default(0)

  owner    User           @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  members  EventMember[]

  @@index([ownerId])
  @@index([categoryId, searchable, startsAt])
  @@index([searchable, catalogVisible, startsAt])
  @@map("events")
}

model GroupCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  parentId  String? @map("parent_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  parent   GroupCategory?  @relation("GroupCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children GroupCategory[] @relation("GroupCategoryHierarchy")
  groups   Group[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("group_categories")
}

model Group {
  id                String   @id @default(cuid())
  legacyId          Int?     @unique @map("legacy_id")
  ownerId           String   @map("owner_id")
  categoryId        String?  @map("category_id")
  title             String
  description       String?
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")
  searchable        Boolean  @default(true)
  privacy           Int      @default(0)
  catalogVisible    Boolean  @default(false) @map("catalog_visible")
  commentsPrivacy   Int?     @map("comments_privacy")
  discussionPrivacy Int?     @map("discussion_privacy")
  inviteEnabled                 Boolean  @default(false) @map("invite_enabled")
  membershipApprovalRequired    Boolean  @default(false) @map("membership_approval_required")
  uploadEnabled                 Boolean  @default(false) @map("upload_enabled")
  views             Int      @default(0)

  owner    User           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category GroupCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  members  GroupMember[]

  @@index([ownerId])
  @@index([categoryId, searchable, catalogVisible])
  @@index([searchable, catalogVisible, createdAt])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  status    Int      @default(1)
  approved  Boolean  @default(true)
  rank      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, status, approved])
  @@map("group_members")
}

model EventMember {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  status    Int      @default(1)
  approved  Boolean  @default(true)
  rsvp      Int      @default(2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("EventMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status, approved])
  @@index([eventId, rsvp])
  @@map("event_members")
}

model ArticleCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  parentId  String? @map("parent_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  parent   ArticleCategory?  @relation("ArticleCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ArticleCategory[] @relation("ArticleCategoryHierarchy")
  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("article_categories")
}

model Article {
  id              String   @id @default(cuid())
  legacyId        Int?     @unique @map("legacy_id")
  authorId        String   @map("author_id")
  categoryId      String?  @map("category_id")
  title           String
  body            String?
  publishedAt     DateTime @map("published_at")
  updatedAt       DateTime @map("updated_at")
  views           Int      @default(0)
  draft           Boolean  @default(false)
  approved        Boolean  @default(false)
  searchable      Boolean  @default(false)
  catalogVisible  Boolean  @default(false) @map("catalog_visible")
  privacy         Int      @default(0)
  commentsPrivacy Int?     @map("comments_privacy")
  featured        Boolean  @default(false)

  author   User             @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([authorId, categoryId])
  @@index([categoryId, approved, draft, searchable, publishedAt])
  @@index([approved, draft, searchable, publishedAt])
  @@index([featured, approved, draft, searchable])
  @@map("articles")
}

model ForumInstance {
  id          String          @id @default(cuid())
  legacyId    Int?            @unique @map("legacy_id")
  mode        String          @default("forum")
  name        String?
  description String?
  position    Int             @default(0)
  categories  ForumCategory[]
  posts       ForumPost[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([mode, position])
  @@map("forum_instances")
}

model ForumCategory {
  id            String          @id @default(cuid())
  legacyId      Int?            @unique @map("legacy_id")
  instanceId    String          @map("instance_id")
  parentId      String?         @map("parent_id")
  title         String
  description   String?
  position      Int             @default(0)
  publicCanRead Boolean         @default(false) @map("public_can_read")
  isLocked      Boolean         @default(false) @map("is_locked")
  instance      ForumInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  parent        ForumCategory?  @relation("ForumCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      ForumCategory[] @relation("ForumCategoryHierarchy")
  posts         ForumPost[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([instanceId, parentId, position])
  @@index([instanceId, publicCanRead])
  @@map("forum_categories")
}

model ForumPost {
  id             String        @id @default(cuid())
  legacyId       Int?          @unique @map("legacy_id")
  authorId       String        @map("author_id")
  instanceId     String        @map("instance_id")
  categoryId     String        @map("category_id")
  parentId       String?       @map("parent_id")
  title          String?
  body           String?
  createdAt      DateTime      @map("created_at")
  modifiedAt     DateTime?     @map("modified_at")
  views          Int           @default(0)
  replyCount     Int           @default(0) @map("reply_count")
  rating         Int?
  isLocked       Boolean       @default(false) @map("is_locked")
  isAnnouncement Boolean       @default(false) @map("is_announcement")
  isSticky       Boolean       @default(false) @map("is_sticky")
  hasAttachments Boolean       @default(false) @map("has_attachments")
  author         User          @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  instance       ForumInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  category       ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent         ForumPost?    @relation("ForumPostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ForumPost[]   @relation("ForumPostReplies")

  @@index([instanceId, categoryId, parentId, createdAt])
  @@index([categoryId, parentId, isSticky, isAnnouncement])
  @@index([parentId, createdAt])
  @@map("forum_posts")
}

model UserIdentityMap {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  sourceSystem    String    @map("source_system")
  sourceTable     String    @map("source_table")
  legacyUserId    Int       @map("legacy_user_id")
  status          String    @default("active")
  reasonCode      String?   @map("reason_code")
  canonicalUserId String?   @map("canonical_user_id")
  importedAt      DateTime? @map("imported_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user      User  @relation("IdentityMapUser", fields: [userId], references: [id], onDelete: Restrict)
  canonical User? @relation("IdentityMapCanonical", fields: [canonicalUserId], references: [id], onDelete: SetNull)

  @@unique([sourceSystem, sourceTable, legacyUserId])
  @@unique([userId, sourceSystem, sourceTable])
  @@index([userId, status])
  @@index([status, reasonCode])
  @@map("user_identity_maps")
}

model BlogCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  parentId  String? @map("parent_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  parent   BlogCategory?  @relation("BlogCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children BlogCategory[] @relation("BlogCategoryHierarchy")
  entries  BlogEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("blog_categories")
}

model BlogEntry {
  id              String   @id @default(cuid())
  legacyId        Int?     @unique @map("legacy_id")
  authorId        String   @map("author_id")
  categoryId      String?  @map("category_id")
  title           String
  body            String?
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  searchable      Boolean  @default(true)
  privacy         Int      @default(63)
  catalogVisible  Boolean  @default(false) @map("catalog_visible")
  commentsPrivacy Int?     @map("comments_privacy")
  views           Int      @default(0)

  author   User          @relation("BlogEntryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([authorId, categoryId])
  @@index([categoryId, searchable, catalogVisible, createdAt])
  @@index([searchable, catalogVisible, createdAt])
  @@map("blog_entries")
}

model Admin {
  id             String         @id @default(cuid())
  legacyId       Int?           @unique @map("legacy_id")
  username       String         @unique
  displayName    String         @map("display_name")
  email          String         @unique
  passwordHash   String         @map("password_hash")
  passwordMethod Int            @default(0) @map("password_method")
  enabled        Boolean        @default(false)
  isSuperAdmin   Boolean        @default(false) @map("is_super_admin")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  sessions       AdminSession[]
  auditLogs      AdminAuditLog[]

  @@index([enabled, isSuperAdmin])
  @@map("admins")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String   @map("admin_id")
  resourceKind String   @map("resource_kind")
  resourceId   String   @map("resource_id")
  summary      String
  changes      Json
  createdAt    DateTime @default(now()) @map("created_at")
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([resourceKind, resourceId, createdAt])
  @@index([adminId, createdAt])
  @@map("admin_audit_logs")
}

model AdminSession {
  id        String   @id
  adminId   String   @map("admin_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// Legacy administrative catalogs. These tables are structure-only until an
// authorized row source and reconciliation plan exist; no User FKs yet.
model UserLevel {
  id           String   @id @default(cuid())
  legacyId     Int?     @unique @map("legacy_id")
  name         String
  description  String
  isDefault    Boolean  @default(false) @map("is_default")
  isSignup     Boolean  @default(false) @map("is_signup")
  capabilities Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  users        User[]

  @@index([isDefault])
  @@index([isSignup])
  @@map("user_levels")
}

model Subnetwork {
  id              String   @id @default(cuid())
  legacyId        Int?     @unique @map("legacy_id")
  nameLegacyId    Int      @default(0) @map("name_legacy_id")
  field1Qualifier String   @default("") @map("field1_qualifier")
  field1Value     String   @default("") @map("field1_value")
  field2Qualifier String   @default("") @map("field2_qualifier")
  field2Value     String   @default("") @map("field2_value")
  themeLegacyId   Int      @default(0) @map("theme_legacy_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  users           User[]

  @@index([nameLegacyId])
  @@index([themeLegacyId])
  @@map("subnetworks")
}

model LanguageVariable {
  id           String   @id @default(cuid())
  legacyId     Int      @map("legacy_id")
  languageId   Int      @map("language_id")
  value        String?
  defaultValue String?  @map("default_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([legacyId, languageId])
  @@index([languageId, legacyId])
  @@map("language_variables")
}

model Setting {
  id              String   @id @default(cuid())
  legacyId        Int?     @unique @map("legacy_id")
  key             String   @default("")
  version         String   @default("")
  isOnline        Boolean  @default(true) @map("is_online")
  urlEnabled      Boolean  @default(false) @map("url_enabled")
  usernameEnabled Boolean  @default(true) @map("username_enabled")
  subnetField1Id  Int      @default(-2) @map("subnet_field1_id")
  subnetField2Id  Int      @default(-2) @map("subnet_field2_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("settings")
}

model Album {
  id             String   @id @default(cuid())
  legacyId       Int?     @unique @map("legacy_id")
  ownerId        String   @map("owner_id")
  title          String
  description    String?
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")
  searchable     Boolean  @default(true)
  privacy        Int      @default(0)
  catalogVisible Boolean  @default(false) @map("catalog_visible")
  commentsPrivacy Int?    @map("comments_privacy")
  coverMediaId   String?  @map("cover_media_id")
  views          Int      @default(0)
  totalFiles     Int      @default(0) @map("total_files")
  sortOrder      Int      @default(0) @map("sort_order")

  owner  User         @relation("AlbumOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  media  AlbumMedia[]

  @@index([ownerId])
  @@index([searchable, catalogVisible, createdAt])
  @@map("albums")
}

model AlbumMedia {
  id          String   @id @default(cuid())
  legacyId    Int?     @unique @map("legacy_id")
  albumId     String   @map("album_id")
  title       String   @default("")
  description String?
  extension   String   @default("")
  filesize    Int      @default(0)
  mimeType    String?  @map("mime_type")
  storageKey  String?  @map("storage_key")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, sortOrder])
  @@map("album_media")
}

model Poll {
  id             String   @id @default(cuid())
  legacyId       Int?     @unique @map("legacy_id")
  ownerId        String   @map("owner_id")
  title          String
  description    String?
  options        Json
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  searchable     Boolean  @default(true)
  privacy        Int      @default(0)
  catalogVisible Boolean  @default(false) @map("catalog_visible")
  commentsPrivacy Int?    @map("comments_privacy")
  closed         Boolean  @default(false)
  totalVotes     Int      @default(0) @map("total_votes")
  views          Int      @default(0)

  owner User       @relation("PollOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  votes PollVote[]

  @@index([ownerId])
  @@index([searchable, catalogVisible, createdAt])
  @@index([searchable, catalogVisible, totalVotes])
  @@map("polls")
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String   @map("poll_id")
  userId      String   @map("user_id")
  optionIndex Int      @map("option_index")
  createdAt   DateTime @default(now()) @map("created_at")

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation("PollVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId, optionIndex])
  @@index([userId])
  @@map("poll_votes")
}
