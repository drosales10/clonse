// Esquema inicial de destino para la vertical de acceso.
// No ejecutar migraciones hasta inspeccionar el esquema PostgreSQL disponible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String    @unique
  displayName          String    @map("display_name")
  status               String?
  statusUpdatedAt      DateTime? @map("status_updated_at")
  profilePrivacy       Int       @default(63) @map("profile_privacy")
  commentsPrivacy      Int       @default(63) @map("comments_privacy")
  passwordHash         String    @map("password_hash")
  passwordMethod       Int       @default(0) @map("password_method")
  verificationTokenHash String?   @map("verification_token_hash")
  verificationSentAt   DateTime? @map("verification_sent_at")
  verifiedAt            DateTime? @map("verified_at")
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetSentAt   DateTime? @map("password_reset_sent_at")
  enabled              Boolean   @default(true)
  signUpDate           DateTime  @default(now()) @map("sign_up_date")
  loginCount            Int       @default(0) @map("login_count")
  lastLoginAt          DateTime? @map("last_login_at")
  lastActiveAt         DateTime? @map("last_active_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  sessions             AuthSession[]
  profileFieldValues   ProfileFieldValue[]
  friendRequestsSent   FriendConnection[] @relation("FriendRequester")
  friendRequestsReceived FriendConnection[] @relation("FriendAddressee")
  blocksCreated        ProfileBlock[] @relation("ProfileBlocker")
  blocksReceived       ProfileBlock[] @relation("ProfileBlocked")
  activities            Activity[] @relation("ActivityActor")
  profileCommentsReceived ProfileComment[] @relation("ProfileCommentOwner")
  profileCommentsAuthored ProfileComment[] @relation("ProfileCommentAuthor")

  @@index([enabled, verifiedAt])
  @@map("users")
}

model AuthSession {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model FriendConnection {
  id          String   @id @default(cuid())
  requesterId String   @map("requester_id")
  addresseeId String   @map("addressee_id")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("friend_connections")
}

model ProfileBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("ProfileBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ProfileBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("profile_blocks")
}

model ProfileCategory {
  id        String  @id @default(cuid())
  legacyId  Int?    @unique @map("legacy_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  parentId  String? @map("parent_id")

  parent   ProfileCategory?  @relation("ProfileCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProfileCategory[] @relation("ProfileCategoryHierarchy")
  fields   ProfileField[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, sortOrder])
  @@index([active, sortOrder])
  @@map("profile_categories")
}

model ProfileField {
  id             String  @id @default(cuid())
  legacyId       Int?    @unique @map("legacy_id")
  categoryId     String  @map("category_id")
  parentFieldId  String? @map("parent_field_id")
  fieldKey       String  @unique @map("field_key")
  label          String
  description    String?
  type           String
  sortOrder      Int     @default(0) @map("sort_order")
  required       Boolean @default(false)
  maxLength      Int?    @map("max_length")
  options        Json?
  displayMode    Int     @default(1) @map("display_mode")
  validationRegex String? @map("validation_regex")
  allowHtml      Boolean @default(false) @map("allow_html")
  active         Boolean @default(true)

  category       ProfileCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parentField    ProfileField?   @relation("ProfileFieldDependency", fields: [parentFieldId], references: [id], onDelete: SetNull)
  dependentFields ProfileField[] @relation("ProfileFieldDependency")
  values         ProfileFieldValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId, active, sortOrder])
  @@index([parentFieldId])
  @@map("profile_fields")
}

model ProfileFieldValue {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  fieldId   String       @map("field_id")
  value     Json
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  field ProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([userId, fieldId])
  @@index([fieldId])
  @@map("profile_field_values")
}

model Activity {
  id              String   @id @default(cuid())
  actorId         String   @map("actor_id")
  type            String
  text            String
  objectPrivacy   Int      @map("object_privacy")
  createdAt       DateTime @default(now()) @map("created_at")

  actor User @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, type, createdAt])
  @@index([createdAt])
  @@map("activities")
}

model ProfileComment {
  id             String   @id @default(cuid())
  profileOwnerId String   @map("profile_owner_id")
  authorId       String   @map("author_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  profileOwner User @relation("ProfileCommentOwner", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  author       User @relation("ProfileCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([profileOwnerId, createdAt])
  @@index([authorId, createdAt])
  @@map("profile_comments")
}
